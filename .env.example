# ─── Site ────────────────────────────────────────────────────────────────
# Canonical origin used for canonical URLs, sitemap and Open Graph.
PUBLIC_SITE_URL=https://labels.fyi

# ─── Content source ──────────────────────────────────────────────────────
# auto  → use Sanity when SANITY_PROJECT_ID is set, otherwise the local demo dataset
# sanity → always Sanity (build fails if not configured)
# demo  → always the local, clearly-marked fictional demo dataset
CONTENT_SOURCE=auto

# ─── Sanity (read side, used by the Astro build) ─────────────────────────
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2025-02-19
# Optional. Only needed if the dataset is private. Server-only; never exposed to the client.
SANITY_READ_TOKEN=

# ─── Sanity Studio (sanity/.env) ────────────────────────────────────────
# The studio reads SANITY_STUDIO_PROJECT_ID and SANITY_STUDIO_DATASET.
# See sanity/.env.example.

# ─── Analytics (all optional; nothing loads when unset) ──────────────────
PUBLIC_GA_MEASUREMENT_ID=
PUBLIC_CF_ANALYTICS_TOKEN=
PUBLIC_GSC_VERIFICATION=
