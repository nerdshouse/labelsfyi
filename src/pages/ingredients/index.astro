---
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getContentGraph } from '@/lib/content/repository';
import { routes } from '@/lib/seo/site';

const { ingredients } = await getContentGraph();
const byLetter = new Map<string, typeof ingredients>();
for (const i of ingredients) {
  const letter = i.name[0]!.toUpperCase();
  byLetter.set(letter, [...(byLetter.get(letter) ?? []), i]);
}
const crumbs = [{ name: 'Ingredients', href: '/ingredients' }];
---

<BaseLayout
  title="Supplement ingredients A–Z"
  description="What common supplement ingredients are, the forms you'll see on labels, studied doses and what the evidence says."
  crumbs={crumbs}
>
  <div class="page pt-5">
    <Breadcrumbs items={crumbs} />
    <header class="mt-6 max-w-3xl">
      <h1 class="display">Ingredients</h1>
      <p class="lede mt-4">
        What it is, the names it goes by on labels, what’s been studied and what to check before
        buying.
      </p>
    </header>
    <div class="mt-12 space-y-10">
      {[...byLetter.entries()].map(([letter, items]) => (
        <section
          class="grid gap-x-6 border-t-[6px] border-ink pt-3 md:grid-cols-[4rem_1fr]"
          aria-label={letter}
        >
          <h2 class="font-serif text-4xl font-medium">{letter}</h2>
          <ul>
            {items.map((i) => (
              <li class="border-b border-line">
                <a
                  href={routes.ingredient(i.slug)}
                  class="group grid gap-x-6 py-4 md:grid-cols-[16rem_1fr_auto]"
                >
                  <span class="text-lg font-semibold group-hover:underline">{i.name}</span>
                  <span class="text-sm text-ink-2">{i.summary}</span>
                  <span class="num font-mono text-xs text-ink-3 md:text-right">
                    {i.products.length} products
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>
