---
import SearchBox from '@/components/search/SearchBox.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';

const browse = [
  { href: '/products', label: 'All products' },
  { href: '/ingredients', label: 'Ingredients A–Z' },
  { href: '/compare', label: 'Comparisons' },
  { href: '/guides', label: 'Guides' },
];
---

<BaseLayout
  title="Search"
  description="Search supplement products, ingredients, brands, comparisons and guides."
  canonicalPath="/search"
  noindex
  hideHeaderSearch
>
  <div class="page pt-8 sm:pt-12">
    <h1 class="caption text-ink-3">Search labels.fyi</h1>
    <div class="mt-3 max-w-3xl">
      <SearchBox variant="page" id="page-search" autofocus />
    </div>

    <div class="mt-10" data-comparison-slot hidden></div>

    <div class="mt-8 max-w-3xl" aria-live="polite" data-search-results>
      <div data-state="idle">
        <p class="caption text-ink-3">Browse</p>
        <ul class="mt-2 border-t border-ink">
          {browse.map((b) => (
            <li class="border-b border-line">
              <a href={b.href} class="block py-3 font-medium hover:underline">
                {b.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
      <p data-state="loading" hidden class="py-6 text-ink-3">
        Searching…
      </p>
      <div data-state="empty" hidden>
        <p class="text-lg">
          No matches for <strong data-query class="font-semibold"></strong>.
        </p>
        <ul class="mt-3 list-[square] space-y-1 pl-5 text-ink-2">
          <li>Check the spelling, or try a shorter query like an ingredient name (“creatine”).</li>
          <li>Search by what’s on the label: “whey”, “D3”, “magnesium glycinate”.</li>
          <li>
            Browse{' '}
            <a href="/products" class="link">
              all products
            </a>{' '}
            or{' '}
            <a href="/ingredients" class="link">
              ingredients
            </a>
            .
          </li>
        </ul>
        <div
          class="mt-6 grid gap-4 border-t-2 border-ink pt-4 sm:grid-cols-2"
          data-search-empty-ctas
        >
          <div>
            <p class="font-semibold">Already have a product?</p>
            <p class="text-sm text-ink-2">Paste its product page to see what it states.</p>
            <form method="post" action="/analyse" class="mt-2 flex gap-2">
              <label for="search-analyse" class="sr-only">
                Product URL
              </label>
              <input
                id="search-analyse"
                name="url"
                type="url"
                required
                placeholder="https://…"
                class="h-10 min-w-0 flex-1 border border-ink bg-paper px-2"
              />
              <input type="hidden" name="action" value="analyse" />
              <button class="btn btn-quiet min-h-10">Analyse</button>
            </form>
          </div>
          <div>
            <p class="font-semibold">Don’t see your supplement?</p>
            <p class="text-sm text-ink-2">Send us the front and back of the label.</p>
            <p class="mt-2">
              <a href="/submit" class="btn btn-quiet">
                Send a label
              </a>
            </p>
          </div>
        </div>
      </div>
      <p data-state="error" hidden class="notice">
        Search couldn’t load. Check your connection and try again, or browse{' '}
        <a href="/products" class="link">
          products
        </a>
        .
      </p>
      <div data-state="results" hidden></div>
    </div>
    <noscript>
      <p class="notice mt-6 max-w-3xl">
        Search needs JavaScript. You can browse{' '}
        <a href="/products" class="link">
          products
        </a>
        ,{' '}
        <a href="/ingredients" class="link">
          ingredients
        </a>{' '}
        and{' '}
        <a href="/guides" class="link">
          guides
        </a>{' '}
        instead.
      </p>
    </noscript>
  </div>
</BaseLayout>

<script>
  import { initFormulaFilters } from '@/components/comparison/formula-filters';
  import { loadEngine, TYPE_LABEL } from '@/components/search/search-client';
  import { normalize } from '@/lib/search/engine';
  import { track } from '@/lib/analytics/events';
  import type { SearchDocument } from '@/lib/content/types';

  const root = document.querySelector<HTMLElement>('[data-search-results]')!;
  const input = document.querySelector<HTMLInputElement>('#page-search')!;
  const states = root.querySelectorAll<HTMLElement>('[data-state]');
  const show = (name: string) => states.forEach((el) => (el.hidden = el.dataset.state !== name));
  const ORDER: SearchDocument['type'][] = [
    'goal',
    'product',
    'ingredient',
    'comparison',
    'brand',
    'guide',
  ];
  const GROUP: Record<SearchDocument['type'], string> = {
    goal: 'Goals',
    product: 'Products',
    ingredient: 'Ingredients',
    comparison: 'Comparisons',
    brand: 'Brands',
    guide: 'Guides',
  };
  const VEG_LABEL: Record<string, string> = {
    VEGETARIAN: 'Veg',
    VEGAN: 'Vegan',
    NON_VEGETARIAN: 'Non-veg',
    UNKNOWN: 'Veg status unknown',
  };

  function el<K extends keyof HTMLElementTagNameMap>(tag: K, cls: string, text?: string) {
    const node = document.createElement(tag);
    node.className = cls;
    if (text !== undefined) node.textContent = text;
    return node;
  }

  // ── Formula comparison for ingredient queries ("magnesium", "bisglycinate") ──
  type ComparisonEntry = { slug: string; name: string; terms: string[]; count: number };
  const slot = document.querySelector<HTMLElement>('[data-comparison-slot]')!;
  let comparisonIndex: Promise<ComparisonEntry[]> | undefined;
  const loadComparisonIndex = () =>
    (comparisonIndex ??= fetch('/comparison-index.json')
      .then((r) => (r.ok ? (r.json() as Promise<ComparisonEntry[]>) : []))
      .catch(() => []));
  let shownSlug: string | null = null;

  async function showComparison(query: string) {
    const q = normalize(query);
    const entries = q ? await loadComparisonIndex() : [];
    const hit = entries.find((e) =>
      e.terms.some(
        (t) => t === q || t.split(' ').includes(q) || (q.length >= 4 && t.startsWith(q)),
      ),
    );
    if (!hit) {
      slot.hidden = true;
      slot.replaceChildren();
      shownSlug = null;
      return;
    }
    if (hit.slug === shownSlug) return;
    try {
      const res = await fetch(`/partials/compare/${hit.slug}`);
      if (!res.ok) throw new Error(String(res.status));
      // Trusted, same-origin, build-time HTML fragment.
      slot.innerHTML = await res.text();
      slot.hidden = false;
      shownSlug = hit.slug;
      initFormulaFilters(slot);
      track('comparison_view', { ingredient: hit.slug, from: 'search' });
    } catch {
      slot.hidden = true;
    }
  }

  async function run(q: string) {
    void showComparison(q);
    const query = q.trim();
    const url = new URL(location.href);
    if (query) url.searchParams.set('q', query);
    else url.searchParams.delete('q');
    history.replaceState(null, '', url);
    if (!query) return show('idle');
    show('loading');
    try {
      const engine = await loadEngine();
      const hits = engine.search(query, { limit: 60 });
      track('search', { from: 'page', results: hits.length });
      if (!hits.length) {
        root.querySelector('[data-query]')!.textContent = `“${query}”`;
        return show('empty');
      }
      const container = root.querySelector<HTMLElement>('[data-state="results"]')!;
      container.replaceChildren();
      container.append(
        el('p', 'caption text-ink-3', `${hits.length} result${hits.length === 1 ? '' : 's'}`),
      );
      for (const type of ORDER) {
        const group = hits.filter((h) => h.doc.type === type);
        if (!group.length) continue;
        const section = el('section', 'mt-6');
        section.append(
          el(
            'h2',
            'caption border-t-[6px] border-ink pt-2 text-ink-3',
            `${GROUP[type]} · ${group.length}`,
          ),
        );
        const list = el('ul', '');
        for (const { doc } of group) {
          const li = el('li', 'border-b border-line');
          const a = el('a', 'group grid grid-cols-[1fr_auto] items-baseline gap-x-3 py-3');
          a.href = doc.url;
          const left = el('span', 'min-w-0');
          left.append(el('span', 'block font-semibold group-hover:underline', doc.title));
          left.append(el('span', 'block text-sm text-ink-3', doc.subtitle));
          a.append(left);
          a.append(
            el(
              'span',
              'caption text-ink-3',
              doc.vegStatus ? (VEG_LABEL[doc.vegStatus] ?? '') : TYPE_LABEL[doc.type],
            ),
          );
          li.append(a);
          list.append(li);
        }
        section.append(list);
        container.append(section);
      }
      show('results');
    } catch {
      show('error');
    }
  }

  const initial = new URL(location.href).searchParams.get('q') ?? '';
  input.value = initial;
  // A query that is exactly a published goal ("sleep", "gut health") opens
  // the goal page; everything else keeps the existing search/comparison.
  void (async () => {
    if (initial.trim()) {
      try {
        const engine = await loadEngine();
        const q = normalize(initial).replace(/&/g, ' ').replace(/\s+/g, ' ').trim();
        const goal = engine
          .search(initial, { limit: 3, type: 'goal' })
          .find(
            (h) => h.doc.keywords.some((k) => normalize(k) === q) || normalize(h.doc.title) === q,
          );
        if (goal) return location.replace(goal.doc.url);
      } catch {
        /* fall through to normal search */
      }
    }
    void run(initial);
  })();

  let timer: number | undefined;
  input.addEventListener('input', () => {
    clearTimeout(timer);
    timer = window.setTimeout(() => void run(input.value), 150);
  });
  input.form?.addEventListener('submit', (e) => {
    e.preventDefault();
    void run(input.value);
  });
</script>
