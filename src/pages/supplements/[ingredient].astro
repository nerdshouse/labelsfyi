---
import ConsumerProductCard from '@/components/catalogue/ConsumerProductCard.astro';
import SearchBox from '@/components/search/SearchBox.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import DemoFlag from '@/components/ui/DemoFlag.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { AFFILIATE_DISCLOSURE } from '@/lib/affiliates';
import { SORT_KEYS, SORT_LABEL } from '@/components/catalogue/listing-filters';
import { ingredientListing, listingIngredients, type ConsumerCard } from '@/lib/catalogue/consumer';
import { getContentGraph } from '@/lib/content/repository';
import type { IngredientDetail } from '@/lib/content/types';
import { formatNumber } from '@/lib/formatting/quantity';

/**
 * "Magnesium supplements": the consumer comparison page for one ingredient.
 * Built from the published graph (one pass; no per-card queries). Filters are
 * derived from the data; sorts are single transparent criteria; there is no
 * score or ranking. Compare links only pair products containing this
 * ingredient, so different ingredients are never compared as equivalent.
 */
export async function getStaticPaths() {
  const graph = await getContentGraph();
  return listingIngredients(graph).map((ingredient) => ({
    params: { ingredient: ingredient.slug },
    props: { ingredient },
  }));
}

interface Props {
  ingredient: IngredientDetail;
}
const graph = await getContentGraph();
const v = ingredientListing(graph, Astro.props.ingredient);
const name = v.ingredient.name;
const lower = name.toLowerCase();
const f = v.facets;
const crumbs = [
  { name: 'Supplements', href: '/products' },
  { name: `${name} supplements`, href: v.path },
];
// Cards show their first buy link; disclose when any rendered link is an affiliate link.
const anyAffiliate = v.cards.some((c) => c.buy[0]?.affiliate);
const partners = (c: ConsumerCard) => v.cards.filter((x) => x.slug !== c.slug);
const compoundName = f.compound?.kind === 'declared' ? 'Declared amount' : 'Compound amount';
// A sort is offered only when it compares like with like (docs/comparison.md).
const sorts = SORT_KEYS.filter((s) =>
  s === 'price'
    ? f.price
    : s === 'elemental'
      ? f.elemental?.sortable
      : s === 'compound'
        ? f.compound?.sortable
        : true,
);
const sortLabel = (s: (typeof SORT_KEYS)[number]) =>
  s === 'compound' && f.compound?.kind === 'declared'
    ? 'Declared amount (highest first)'
    : SORT_LABEL[s];
const mixedCompound = f.compound !== null && !f.compound.sortable && f.compound.form === null;
---

<BaseLayout
  title={`${name} supplements: compare labels, amounts and prices`}
  description={`Compare ${v.cards.length} ${lower} product${v.cards.length === 1 ? '' : 's'} by declared amount, form, serving, label evidence, observed price and where to buy. No rankings.`}
  canonicalPath={v.path}
  noindex={!v.indexable}
  crumbs={crumbs}
>
  <div class="page pt-5" data-listing={v.ingredient.slug}>
    <Breadcrumbs items={crumbs} />
    <header class="mt-6 max-w-3xl">
      <p class="caption text-ink-3">Compare</p>
      <h1 class="display mt-2">{name} supplements</h1>
      <p class="lede mt-3">
        Compare {lower} products by ingredients, amounts, label evidence, price and where to buy.
      </p>
      <p class="mt-3 text-sm text-ink-2">
        <span class="num font-mono">{v.cards.length}</span> product{v.cards.length === 1 ? '' : 's'}{' '}
        ·{' '}
        <a href={`/ingredients/${v.ingredient.slug}`} class="link">
          About {lower}
        </a>
        {v.goals.length > 0 && (
          <>
            {' · Goals: '}
            {v.goals.map((g, i) => (
              <>
                {i > 0 && ', '}
                <a href={`/${g.slug}`} class="link">
                  {g.name}
                </a>
              </>
            ))}
          </>
        )}
      </p>
    </header>

    {v.cards.some((c) => c.isDemo) && (
      <div class="mt-8">
        <DemoFlag what="This page" />
      </div>
    )}

    <form
      class="mt-8 flex flex-wrap items-end gap-x-5 gap-y-3 border-y-2 border-ink py-3 text-sm"
      data-listing-filters
      onsubmit="return false"
    >
      {f.forms.length > 0 && (
        <label class="flex items-center gap-2">
          Form
          <select name="form" class="h-9 border border-ink bg-paper px-2">
            <option value="">Any form</option>
            {f.forms.map((x) => (
              <option value={x}>{x}</option>
            ))}
          </select>
        </label>
      )}
      {f.elemental?.range && f.elemental.sortable && (
        <fieldset class="flex items-center gap-2" data-filter="elemental">
          <legend class="sr-only">Elemental amount per serving ({f.elemental.unit})</legend>
          <span>Elemental amount ({f.elemental.unit}/serving)</span>
          <input
            type="number"
            name="minElemental"
            min="0"
            step="any"
            placeholder={formatNumber(f.elemental.range.min)}
            aria-label={`Minimum elemental ${f.elemental.unit}`}
            class="h-9 w-20 border border-ink bg-paper px-2 font-mono"
          />
          <span>–</span>
          <input
            type="number"
            name="maxElemental"
            min="0"
            step="any"
            placeholder={formatNumber(f.elemental.range.max)}
            aria-label={`Maximum elemental ${f.elemental.unit}`}
            class="h-9 w-20 border border-ink bg-paper px-2 font-mono"
          />
        </fieldset>
      )}
      {f.compound?.range && f.compound.sortable && (
        <fieldset class="flex items-center gap-2" data-filter="compound">
          <legend class="sr-only">
            {compoundName} per serving ({f.compound.unit})
          </legend>
          <span>
            {compoundName}
            {f.compound.form ? ` (${f.compound.form})` : ''} ({f.compound.unit}/serving)
          </span>
          <input
            type="number"
            name="minCompound"
            min="0"
            step="any"
            placeholder={formatNumber(f.compound.range.min)}
            aria-label={`Minimum ${compoundName.toLowerCase()} ${f.compound.unit}`}
            class="h-9 w-20 border border-ink bg-paper px-2 font-mono"
          />
          <span>–</span>
          <input
            type="number"
            name="maxCompound"
            min="0"
            step="any"
            placeholder={formatNumber(f.compound.range.max)}
            aria-label={`Maximum ${compoundName.toLowerCase()} ${f.compound.unit}`}
            class="h-9 w-20 border border-ink bg-paper px-2 font-mono"
          />
        </fieldset>
      )}
      {f.brands.length > 0 && (
        <label class="flex items-center gap-2">
          Brand
          <select name="brand" class="h-9 border border-ink bg-paper px-2">
            <option value="">Any brand</option>
            {f.brands.map((b) => (
              <option value={b}>{b}</option>
            ))}
          </select>
        </label>
      )}
      {f.veg && (
        <label class="flex items-center gap-2">
          <input type="checkbox" name="veg" class="size-4" /> Vegetarian
        </label>
      )}
      {f.verified && (
        <label class="flex items-center gap-2">
          <input type="checkbox" name="verified" class="size-4" /> Label verified
        </label>
      )}
      {f.evidence && (
        <label class="flex items-center gap-2">
          <input type="checkbox" name="evidence" class="size-4" /> Claims checked
        </label>
      )}
      {f.single && (
        <label class="flex items-center gap-2">
          <input type="checkbox" name="single" class="size-4" /> No other actives
        </label>
      )}
      {f.price && (
        <label class="flex items-center gap-2">
          Max ₹ / serving
          <input
            type="number"
            name="maxPrice"
            min="0"
            step="any"
            inputmode="decimal"
            class="h-9 w-20 border border-ink bg-paper px-2 font-mono"
          />
        </label>
      )}
      <label class="flex items-center gap-2">
        Sort
        <select name="sort" class="h-9 max-w-full border border-ink bg-paper px-2">
          {sorts.map((s) => (
            <option value={s}>{sortLabel(s)}</option>
          ))}
        </select>
      </label>
      {mixedCompound && (
        <p class="w-full text-xs text-ink-3" data-compound-note>
          Compound amounts are not sorted here: these products use different forms, so equal
          compound weights do not mean equal amounts of {lower}.
        </p>
      )}
      <p class="ml-auto text-ink-3" aria-live="polite">
        <span data-visible-count>{v.cards.length}</span> shown
      </p>
    </form>

    <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3" data-listing-cards>
      {v.cards.map((c) => (
        <ConsumerProductCard card={c} partners={partners(c)} />
      ))}
    </div>
    <p class="mt-4 hidden text-sm text-ink-3" data-no-match>
      No products match these filters.
    </p>
    {anyAffiliate && (
      <p class="mt-6 text-xs text-ink-3" data-affiliate-disclosure>
        Some purchase links may be affiliate links. {AFFILIATE_DISCLOSURE}
      </p>
    )}

    <section class="mt-14 grid gap-6 border-t-2 border-ink pt-5 sm:grid-cols-2">
      <div>
        <h2 class="font-semibold">Already have a product?</h2>
        <p class="text-sm text-ink-2">
          Paste its product page to see what it states and compare it with these labels.
        </p>
        <form method="post" action="/analyse" class="mt-3 flex gap-2">
          <label for="listing-analyse" class="sr-only">
            Product URL
          </label>
          <input
            id="listing-analyse"
            name="url"
            type="url"
            required
            placeholder="https://…"
            class="h-11 min-w-0 flex-1 border border-ink bg-paper px-2"
          />
          <input type="hidden" name="action" value="analyse" />
          <button class="btn btn-quiet">Analyse</button>
        </form>
      </div>
      <div>
        <h2 class="font-semibold">Don’t see your supplement?</h2>
        <p class="text-sm text-ink-2">
          Send us the front and back of the label. Nothing is published until it is verified.
        </p>
        <p class="mt-3">
          <a href="/submit" class="btn btn-quiet">
            Send a label
          </a>
        </p>
      </div>
    </section>

    <section class="mt-10 max-w-3xl text-sm text-ink-2">
      <h2 class="caption rule-heavy pt-3 text-ink-3">How this comparison works</h2>
      <ul class="mt-2 list-[square] space-y-1 pl-5">
        <li>
          Amounts are as declared. “Elemental amount” is only a figure the label itself states as
          elemental; it is never calculated. “Compound amount” is the weight of the named form (for
          example magnesium citrate) and is only compared between products that use the same form.
        </li>
        <li>Products without a stated value are listed last when sorting by that value.</li>
        <li>
          “Match” summarises three facts (amount disclosed, label verified, price observed). There
          is no score or ranking.
        </li>
        <li>Prices are dated observations, not live offers.</li>
      </ul>
      <p class="mt-3">
        <a href="/methodology" class="link">
          Methodology
        </a>
      </p>
      <div class="mt-6 max-w-xl">
        <SearchBox variant="page" id="listing-search" />
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  import { initListingFilters } from '@/components/catalogue/listing-filters';
  import { track } from '@/lib/analytics/events';
  initListingFilters();
  const el = document.querySelector<HTMLElement>('[data-listing]');
  if (el) track('ingredient_view', { ingredient: el.dataset.listing });
</script>
