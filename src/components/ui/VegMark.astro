---
import type { VegStatus } from '@/lib/content/types';
import { VEG } from '@/lib/editorial/meta';

/**
 * Veg/non-veg symbol in the style used on Indian food labels: a square
 * outline with a filled circle (veg, green) or triangle (non-veg, brown).
 * Vegan uses the veg symbol; the text label says "Vegan". Unknown is a
 * dashed grey outline with a question mark, never a guess.
 */
interface Props {
  status: VegStatus;
  size?: number;
  withLabel?: boolean;
  class?: string;
}
const { status, size = 14, withLabel = false, class: className } = Astro.props;
const color = {
  VEGETARIAN: 'var(--color-veg)',
  VEGAN: 'var(--color-veg)',
  NON_VEGETARIAN: 'var(--color-nonveg)',
  UNKNOWN: 'var(--color-unknown)',
}[status];
const label = VEG[status].label;
---

<span class:list={['inline-flex items-center gap-1.5', className]}>
  <svg
    width={size}
    height={size}
    viewBox="0 0 16 16"
    role="img"
    aria-label={withLabel ? undefined : label}
    aria-hidden={withLabel ? 'true' : undefined}
    class="shrink-0"
  >
    <rect
      x="1"
      y="1"
      width="14"
      height="14"
      fill="none"
      stroke={color}
      stroke-width="1.6"
      stroke-dasharray={status === 'UNKNOWN' ? '2.2 1.6' : undefined}
    ></rect>
    {(status === 'VEGETARIAN' || status === 'VEGAN') && (
      <circle cx="8" cy="8" r="3.6" fill={color} />
    )}
    {status === 'NON_VEGETARIAN' && <path d="M8 4.2 12 11.4H4Z" fill={color} />}
    {status === 'UNKNOWN' && (
      <text
        x="8"
        y="11.6"
        text-anchor="middle"
        font-size="9.5"
        font-weight="600"
        font-family="var(--font-mono)"
        fill={color}
      >
        ?
      </text>
    )}
  </svg>
  {withLabel && <span>{label}</span>}
</span>
