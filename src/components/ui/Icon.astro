---
/** A handful of line icons. Decorative by default (aria-hidden). */
interface Props {
  name: 'search' | 'arrow-right' | 'arrow-up-right' | 'chevron-down' | 'check' | 'x' | 'info';
  size?: number;
  class?: string;
  label?: string;
}
const { name, size = 16, class: className, label } = Astro.props;
const paths: Record<Props['name'], string> = {
  search: '<circle cx="7" cy="7" r="5"/><path d="m11 11 3.5 3.5"/>',
  'arrow-right': '<path d="M2.5 8h11M9 3.5 13.5 8 9 12.5"/>',
  'arrow-up-right': '<path d="M4.5 11.5 11.5 4.5M5.5 4.5h6v6"/>',
  'chevron-down': '<path d="m3.5 6 4.5 4.5L12.5 6"/>',
  check: '<path d="m3 8.5 3.2 3L13 4.5"/>',
  x: '<path d="m4 4 8 8M12 4l-8 8"/>',
  info: '<circle cx="8" cy="8" r="6.2"/><path d="M8 7.2v4M8 4.9v.2"/>',
};
---

<svg
  width={size}
  height={size}
  viewBox="0 0 16 16"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="square"
  class:list={['shrink-0', className]}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  set:html={paths[name]}
/>
