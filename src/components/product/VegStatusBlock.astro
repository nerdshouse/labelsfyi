---
import VegMark from '@/components/ui/VegMark.astro';
import type { ProductDetail } from '@/lib/content/types';
import { VEG } from '@/lib/editorial/meta';
import { formatDate } from '@/lib/formatting/dates';

/** Veg status with its written reason and the dated observations behind it. */
interface Props {
  product: ProductDetail;
  sourceNumbers: Map<string, number>;
}
const { product: p, sourceNumbers } = Astro.props;
const evidence = p.observations.filter(
  (o) => (o.type === 'veg_mark' || o.type === 'ingredient_presence') && !o.supersededAt,
);
---

<div class="grid gap-6 md:grid-cols-[16rem_1fr]">
  <div class="flex items-center gap-4 border-2 border-ink bg-sheet p-4">
    <VegMark status={p.vegStatus} size={40} />
    <div>
      <p class="caption text-ink-3">Veg status</p>
      <p class="text-lg font-semibold">{VEG[p.vegStatus].label}</p>
    </div>
  </div>
  <div>
    <p class="max-w-(--container-prose) text-ink-2">{p.vegStatusReason}</p>
    {p.vegStatus === 'UNKNOWN' && (
      <p class="mt-3 max-w-(--container-prose) text-sm text-ink-3">
        We only record a veg status when the label shows it. If you need to be sure, check the pack
        for the veg mark or contact the brand.
      </p>
    )}
    {evidence.length > 0 && (
      <ul class="mt-4 space-y-1 border-l-[3px] border-line pl-3 text-sm">
        {evidence.map((o) => (
          <li>
            <span class="text-ink-2">{o.value}</span>{' '}
            <span class="num text-xs text-ink-3">
              Observed {formatDate(o.observedAt)}
              {o.source && sourceNumbers.get(o.source._id) && (
                <>
                  {' '}
                  <a href={`#source-${sourceNumbers.get(o.source._id)}`} class="link font-mono">
                    [{sourceNumbers.get(o.source._id)}]
                  </a>
                </>
              )}
            </span>
          </li>
        ))}
      </ul>
    )}
    <p class="mt-4 text-sm">
      <a href="/guides/how-to-check-whether-a-supplement-is-vegetarian" class="link">
        How to check whether a supplement is vegetarian
      </a>
    </p>
  </div>
</div>
