{
  // Cloudflare Workers static assets. The site is fully static; no Worker
  // script is needed. See docs/deployment.md.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "labels-fyi",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
  },
}
